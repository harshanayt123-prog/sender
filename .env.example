# Credentials: set these in Vercel Project Settings > Environment Variables.
# Never commit your real credentials or TELEGRAM_SESSION.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_real_api_hash
TELEGRAM_SESSION=replace_with_real_string_session

# Safety: defaults to preview only (no Telegram messages are sent).
# Change to false only for groups where you have permission to post scheduled announcements.
DRY_RUN=true
INTERVAL_SECONDS=300
DELAY_BETWEEN_GROUPS=10

# Comma-separated Telegram group IDs for each country/language.
# Leave empty to disable a category.
SRI_LANKA_GROUP_IDS=
INDIA_GROUP_IDS=
ROMANIA_GROUP_IDS=
BANGLADESH_GROUP_IDS=
PAKISTAN_GROUP_IDS=
BRAZIL_GROUP_IDS=
INDONESIA_GROUP_IDS=
PHILIPPINES_GROUP_IDS=
MALAYSIA_GROUP_IDS=
UNITED_KINGDOM_GROUP_IDS=
UNITED_STATES_GROUP_IDS=
AUSTRALIA_GROUP_IDS=
CANADA_GROUP_IDS=
UNKNOWN_GROUP_IDS=
LINK_IDS=
BANGLA_IDS=
HINDI_GROUP_IDS=
